# Copy to .env.local and fill in values. Do not commit .env.local.
# Next.js loads .env.local in development (and .env in production unless overridden).

# ========== NextAuth (required for Prayer Google login) ==========
# Get from Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application).
# Authorized redirect URIs must include exactly (use the same origin as NEXTAUTH_URL):
#   http://localhost:3000/api/auth/callback/google
#   OR if using subdomain: http://christian.localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for session signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Must match the URL you use in the browser. Add this exact origin + /api/auth/callback/google to Google Console.
# For localhost:          http://localhost:3000
# For subdomain (e.g.):   http://christian.localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ========== Optional: Firebase (mobile) ==========
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ========== Google Ads API (required; use mock for dev) ==========
GOOGLE_ADS_MODE=mock

# ========== LiveKit (Prayer Live Rooms: audio, recording, screen share) ==========
# Required for live prayer room real-time audio, recording, and screen share.
# Without these, the token API returns 500 and the app shows "Connecting to room…" with controls disabled.
# Get from https://cloud.livekit.io (or self-hosted LiveKit server).
# For Vercel: set the same names in Project → Settings → Environment Variables.
# LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
