  "screens": [
    {
      "id": "slide-hero",
      "stepLabel": "Start",
      "layout": "hero",
      "title": "Deterministic Learn bridge",
      "subtitle": "Structure declares order and kind; content fills each slide id.",
      "content": [
        {
          "type": "badge",
          "text": "Demo"
        },
        {
          "type": "paragraph",
          "text": "This deck was generated with npm run learn from structure.demo.json and content.demo.json."
        }
      ],
      "media": [
        {
          "type": "image",
          "src": "/images/demo/translator-hero.jpg",
