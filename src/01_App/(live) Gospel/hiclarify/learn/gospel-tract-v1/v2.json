        "stepLabel": "Repentance — urgency",
        "layout": "stamped",
        "title": "Do not harden your heart",
        "content": [
          {
            "type": "paragraph",
            "text": "Don't wait until it's too late—hardening your heart risks your soul, and God is not obligated to wait for you to decide to follow Him."
          },
          {
            "type": "paragraph",
            "text": "Believe in Jesus and be saved today; He is coming soon to judge the world and receive His bride."
          }
        ],
        "media": ["/images/gospel/urgency.jpg"],
        "buttons": [
          { "type": "next", "label": "Continue", "nodeId": "way-repentance-02-next" }
