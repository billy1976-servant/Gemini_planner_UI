        "id": "way-fe-02",
        "stepLabel": "Final exam 02",
        "layout": "stamped",
        "title": "Will you turn from your sins, confess Jesus is LORD, and surrender?",
        "content": [
          {
            "type": "paragraph",
            "text": "God offers you the incredible gift of eternal life through His Son, Jesus, if you're willing to give up your life in exchange."
          },
          {
            "type": "paragraph",
            "text": "There is nothing you can do to earn salvation but to receive it by faith."
          }
        ],
        "media": ["/images/gospel/final-exam-2.jpg"],
        "buttons": [
          { "type": "next", "label": "Continue", "nodeId": "way-fe-02-next" }
