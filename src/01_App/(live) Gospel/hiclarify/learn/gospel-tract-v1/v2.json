      {
        "id": "way-fe-01",
        "stepLabel": "Final exam 01",
        "layout": "stamped",
        "title": "Do you believe Jesus died for your sins and rose from the dead?",
        "content": [
          {
            "type": "paragraph",
            "text": "Most believe Jesus existed and even died on the cross, but God requires us to believe that He raised His Son from the grave for salvation."
          }
        ],
        "media": ["/images/gospel/final-exam-1.jpg"],
        "buttons": [
          { "type": "next", "label": "Continue", "nodeId": "way-fe-01-next" }
