        "stepLabel": "Repentance",
        "layout": "stamped",
        "title": "Repentance is key",
        "content": [
          {
            "type": "paragraph",
            "text": "Repentance is a change of heart and mind that aligns with God, turning from our ways to His."
          },
          {
            "type": "paragraph",
            "text": "We must acknowledge our sins and recognize our need for forgiveness."
          },
          {
            "type": "paragraph",
            "text": "If we humble ourselves and call on the Lord, He will save us."
          }
        ],
        "media": ["/images/gospel/repentance.jpg"],
        "buttons": [
          { "type": "next", "label": "Continue", "nodeId": "way-repentance-01-next" }
        ]
      },
