    {
      "id": "way-fe-01",
      "stepLabel": "Final exam 01",
      "layout": "stamped",
      "title": "01 Do you believe Jesus died for your sins and rose from the dead? (the Gospel)",
      "content": [
        {
          "type": "paragraph",
