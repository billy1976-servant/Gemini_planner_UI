        "long"
      ]
    },
    {
      "id": "goodness-cmds-2",
      "stepLabel": "Goodness test — VI–VIII",
      "layout": "stamped",
      "title": "A few of the commandments (2)",
      "content": [
        {
          "type": "paragraph",
          "text": "VI You shall not Murder (murderer) — Jesus said hatred is murder. Ever hated anyone?"
        },
        {
          "type": "paragraph",
          "text": "VII Do not commit adultery (adulterer) — Have you ever looked at someone with lust?"
        },
        {
          "type": "paragraph",
          "text": "VIII You shall not steal (thief) — Have you ever taken anything that's not yours?"
        }
      ],
      "media": [],
      "buttons": [
        {
          "type": "next",
          "label": "Continue",
          "nodeId": "goodness-cmds-2-next"
        }
      ],
      "modes": [
