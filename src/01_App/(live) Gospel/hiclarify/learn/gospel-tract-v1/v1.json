    {
      "id": "goodness-cmds-1",
      "stepLabel": "Goodness test — I, III, V",
      "layout": "stamped",
      "title": "A few of the commandments (1)",
      "content": [
        {
          "type": "paragraph",
          "text": "I No other gods (Idolater) — Has God always come first in your life?"
        },
        {
          "type": "paragraph",
          "text": "III Take God's name in vain (blasphemer) — Ever used God's name without reverence?"
        },
        {
          "type": "paragraph",
          "text": "V Honor your Parents (rebellious) — Have you always honored your parents?"
        }
      ],
      "media": [],
      "buttons": [
        {
          "type": "next",
          "label": "Continue",
          "nodeId": "goodness-cmds-1-next"
        }
      ],
